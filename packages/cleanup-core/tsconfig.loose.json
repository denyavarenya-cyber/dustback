{
  "//": "The Noventia app checks these sources with its own tsconfig (expo/tsconfig.base, not strict). This mirrors it so the module passes there too.",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "types": []
  },
  "include": ["src"]
}
